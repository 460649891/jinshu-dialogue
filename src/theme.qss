QWidget { font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif; font-size: 13px; color: #dce7ed; }
QMainWindow, QWidget#appRoot { background: #0b121b; }
QLabel { background: transparent; }
QLabel#brandTitle { color: #eef6f6; font-size: 23px; font-weight: 600; }
QLabel#brandMark { background: #163b35; color: #87e4cd; border: 1px solid #356257; border-radius: 12px; font-family: "Microsoft YaHei"; font-size: 23px; }
QLabel#muted, QLabel#version { color: #99afbd; font-size: 12px; }
QLabel#version { padding-left: 4px; }
QLabel#statusBadge { color: #b6c7d2; background: #1c2935; border: 1px solid #34424f; border-radius: 13px; padding: 6px 12px; font-size: 12px; }
QLabel#statusBadge[state="connected"] { color: #92e5cf; background: #14362f; border-color: #326256; }
QLabel#statusBadge[state="demo"] { color: #a5d8e5; background: #16313d; border-color: #315565; }
QLabel#statusBadge[state="waiting"] { color: #e0cc98; background: #322e20; border-color: #61563b; }
QLabel#statusBadge[state="error"] { color: #ffc0b4; background: #3a2629; border-color: #70494a; }
QFrame#connectionPanel { background: #111d29; border: 1px solid #293746; border-radius: 12px; }
QLabel#fieldLabel { color: #c4d3dc; font-size: 12px; }
QLabel#statusMessage { color: #a6b9c6; font-size: 12px; }
QLabel#statusMessage[error="true"] { color: #ffb4a5; }
QLineEdit { color: #dce8ef; background: #0c1621; border: 1px solid #344555; border-radius: 7px; padding: 10px 12px; min-height: 20px; selection-background-color: #285e53; }
QLineEdit:focus { border: 1px solid #78d9c0; }
QLineEdit:disabled { color: #9aaab6; background: #131e28; }
QPushButton { color: #d5e3ec; background: #1b2a39; border: 1px solid #3a4b5c; border-radius: 7px; padding: 9px 14px; min-height: 22px; }
QPushButton:hover { background: #263b4d; border-color: #587083; }
QPushButton:pressed { background: #11232f; }
QPushButton:focus { border: 1px solid #88e4cd; }
QPushButton:disabled { color: #8495a3; background: #15212d; border-color: #2c3946; }
QPushButton#primaryButton { color: #082b25; background: #7bd8be; border-color: #7bd8be; font-weight: 600; }
QPushButton#primaryButton:hover { background: #a0e7d3; }
QPushButton#primaryButton:pressed { background: #59bca3; }
QPushButton#primaryButton:disabled { color: #a3b9b5; background: #24483e; border-color: #35584e; }
QPushButton#copyButton { color: #9be5d2; background: #183a33; border-color: #386658; }
QPushButton#copyButton:hover { background: #235246; }
QPushButton#copyButton:disabled { color: #829e97; background: #192c2a; border-color: #2d4540; }
QPushButton#latestButton { color: #9be5d2; background: #142f2a; border-color: #3e6d5d; }
QPushButton#latestButton:disabled { color: #96a9b5; background: #111c27; border-color: #293746; }
QPushButton#quietButton { background: transparent; border-color: transparent; color: #a6bdcc; padding: 4px 5px; min-height: 22px; }
QPushButton#quietButton:hover { color: #d9eee7; background: #192a36; }
QPushButton#quietButton:focus { border-color: #80d7c0; }
QPushButton#quietButton:disabled { color: #7a8d9c; }
QCheckBox { color: #b5c9d5; spacing: 7px; padding: 6px 0; }
QCheckBox:focus { color: #97e1ce; }
QCheckBox::indicator { width: 16px; height: 16px; background: #0d1823; border: 1px solid #536878; border-radius: 4px; }
QCheckBox::indicator:checked { background: #71cdb3; border: 4px solid #285c4e; }
QCheckBox::indicator:hover { border-color: #8bdfc8; }
QFrame#readerPanel { background: #101923; border: 1px solid #2b3948; border-radius: 11px; }
QLabel#panelTitle { color: #d9e7ef; font-size: 14px; font-weight: 600; }
QListView#dialogueList { background: #101923; border: none; outline: none; padding: 0 0 6px 0; }
QListView#dialogueList:focus { border: none; }
QTextEdit#detailText { background: transparent; color: #e1e9ed; border: none; font-size: 17px; padding: 6px 0; selection-background-color: #2c6a5b; selection-color: #f2fffb; }
QLabel#detailSpeaker { color: #8cddc8; font-size: 21px; font-weight: 600; padding-top: 14px; }
QLabel#emptyTitle { color: #b8d5d7; font-size: 23px; }
QLabel#emptyCaption { color: #9bb0bd; font-size: 13px; line-height: 1.6; }
QSplitter::handle { background: #0b121b; }
QSplitter::handle:hover { background: #25423c; }
QScrollBar:vertical { background: #101923; width: 10px; margin: 3px 1px; }
QScrollBar::handle:vertical { background: #3c5261; min-height: 34px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #638677; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { color: #e6f0f2; background: #1f3343; border: 1px solid #597280; padding: 6px; }
